public with sharing class ClaculatorClass {
    public integer addTwoNumber(integer num1, integer num2){
        return num1 + num2;
    }
    public integer subTwoNumber(integer num1, integer num2){
        return num1 - num2;
    }
    public integer multiplyTwoNumber(integer num1, integer num2){
        return num1 * num2;
    }
   
}